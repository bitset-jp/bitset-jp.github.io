---
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/translations';

const lang = (Astro.currentLocale ?? 'ja') as Lang;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-primary-950 text-primary-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <span class="text-2xl font-bold text-white tracking-tight">
          <span class="text-accent-400">&lt;</span>bitset<span class="text-accent-400">&gt;</span>
        </span>
        <p class="mt-3 text-sm text-primary-300 leading-relaxed">
          {t('footer.tagline1')}<br />
          {t('footer.tagline2')}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t('footer.navigation')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={getLocalizedPath('/', lang)} class="hover:text-white transition-colors">{t('nav.home')}</a></li>
          <li><a href={getLocalizedPath('/about', lang)} class="hover:text-white transition-colors">{t('nav.about')}</a></li>
          <li><a href={getLocalizedPath('/services', lang)} class="hover:text-white transition-colors">{t('nav.services')}</a></li>
          <li><a href={getLocalizedPath('/products', lang)} class="hover:text-white transition-colors">{t('nav.products')}</a></li>
          <li><a href={getLocalizedPath('/news', lang)} class="hover:text-white transition-colors">{t('nav.news')}</a></li>
          <li><a href={getLocalizedPath('/recruit', lang)} class="hover:text-white transition-colors">{t('nav.recruit')}</a></li>
          <li><a href={getLocalizedPath('/contact', lang)} class="hover:text-white transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t('footer.contact')}</h3>
        <ul class="space-y-2 text-sm">
          <li>bitset Inc. (株式会社 bitset)</li>
          <li>{t('contact.info.addressValue1')}</li>
          <li>{t('contact.info.addressValue2')}</li>
          <li>Tel: 050-7119-2899</li>
        </ul>
        <div class="mt-4 flex gap-3">
          <a href="https://www.facebook.com/bitsetjp/" target="_blank" rel="noopener noreferrer"
            class="text-primary-300 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://bitset.jp/youtube" target="_blank" rel="noopener noreferrer"
            class="text-primary-300 hover:text-white transition-colors" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/>
              <path fill="#fff" d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-primary-800 text-center text-xs text-primary-400">
      &copy; 2017 - {year} {t('footer.copyright')}
    </div>
  </div>
</footer>
