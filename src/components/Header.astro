---
import { useTranslations, getLocalizedPath, getAlternateLang } from '../i18n/utils';
import { languages, type Lang } from '../i18n/translations';

const lang = (Astro.currentLocale ?? 'ja') as Lang;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);

const navLinks = [
  { href: getLocalizedPath('/', lang), label: t('nav.home') },
  { href: getLocalizedPath('/about', lang), label: t('nav.about') },
  { href: getLocalizedPath('/services', lang), label: t('nav.services') },
  { href: getLocalizedPath('/products', lang), label: t('nav.products') },
  { href: getLocalizedPath('/news', lang), label: t('nav.news') },
  { href: getLocalizedPath('/recruit', lang), label: t('nav.recruit') },
  { href: getLocalizedPath('/contact', lang), label: t('nav.contact') },
];

const currentPath = Astro.url.pathname;
const switchPath = getLocalizedPath(currentPath.replace(/^\/en(\/|$)/, '/'), altLang);
---

<header class="sticky top-0 z-50 bg-primary-950/95 backdrop-blur-sm border-b border-primary-800">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2 group">
        <span class="text-2xl font-bold text-white tracking-tight">
          <span class="text-accent-400">&lt;</span>bitset<span class="text-accent-400">&gt;</span>
        </span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-medium transition-colors',
              currentPath === link.href || (link.href !== getLocalizedPath('/', lang) && currentPath.startsWith(link.href))
                ? 'bg-primary-800 text-white'
                : 'text-primary-200 hover:text-white hover:bg-primary-800/50',
            ]}
          >
            {link.label}
          </a>
        ))}

        <a
          href={switchPath}
          class="ml-2 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-primary-200 hover:text-white hover:bg-primary-800/50 transition-colors border border-primary-700"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          {languages[altLang]}
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="md:hidden text-primary-200 hover:text-white p-2"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block px-4 py-2 rounded-lg text-sm font-medium transition-colors',
            currentPath === link.href || (link.href !== getLocalizedPath('/', lang) && currentPath.startsWith(link.href))
              ? 'bg-primary-800 text-white'
              : 'text-primary-200 hover:text-white hover:bg-primary-800/50',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={switchPath}
        class="flex items-center gap-1.5 px-4 py-2 mt-2 rounded-lg text-sm font-medium text-primary-200 hover:text-white hover:bg-primary-800/50 transition-colors border border-primary-700"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        {languages[altLang]}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
