---
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/translations';

interface Props {
  title: string;
  subtitle?: string;
  showCta?: boolean;
}

const { title, subtitle, showCta = false } = Astro.props;
const lang = (Astro.currentLocale ?? 'ja') as Lang;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 40px 40px;">
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" set:html={title} />
      {subtitle && (
        <p class="mt-6 text-lg md:text-xl text-primary-200 leading-relaxed">
          {subtitle}
        </p>
      )}
      {showCta && (
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={getLocalizedPath('/services', lang)}
            class="inline-flex items-center px-6 py-3 bg-accent-500 hover:bg-accent-600 text-white font-medium rounded-lg transition-colors">
            {t('hero.cta.services')}
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href={getLocalizedPath('/products', lang)}
            class="inline-flex items-center px-6 py-3 border border-primary-400 text-primary-100 hover:bg-primary-800 font-medium rounded-lg transition-colors">
            {t('hero.cta.products')}
          </a>
        </div>
      )}
    </div>
  </div>
</section>
