---
interface Props {
  number: number;
  title: string;
  titleJa: string;
  description: string;
}

const { number, title, titleJa, description } = Astro.props;
---

<div class="relative p-6 bg-white rounded-xl border border-gray-200">
  <div class="absolute -top-4 left-6 w-8 h-8 bg-primary-600 text-white text-sm font-bold rounded-full flex items-center justify-center">
    {number}
  </div>
  <h3 class="text-lg font-semibold text-gray-900 mt-2">{title}</h3>
  <p class="text-sm text-primary-600 font-medium mb-2">{titleJa}</p>
  <p class="text-sm text-gray-600 leading-relaxed">{description}</p>
</div>
