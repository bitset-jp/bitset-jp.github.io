---
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/translations';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
}

const { slug, title, description, category } = Astro.props;
const lang = (Astro.currentLocale ?? 'ja') as Lang;
const t = useTranslations(lang);

const categoryColors: Record<string, string> = {
  'pondashi': 'bg-blue-100 text-blue-700',
  'network-tools': 'bg-purple-100 text-purple-700',
  'iot-tools': 'bg-green-100 text-green-700',
  'hardware': 'bg-orange-100 text-orange-700',
};

const categoryLabel = t(`product.category.${category}` as any);
---

<a href={getLocalizedPath(`/products/${slug}`, lang)}
  class="group block p-6 bg-white rounded-xl border border-gray-200 hover:border-primary-300 hover:shadow-lg transition-all duration-300">
  <span class:list={['inline-block px-2.5 py-0.5 rounded-full text-xs font-medium mb-3', categoryColors[category] || 'bg-gray-100 text-gray-700']}>
    {categoryLabel}
  </span>
  <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors mb-2">
    {title}
  </h3>
  <p class="text-sm text-gray-600 leading-relaxed mb-4">{description}</p>
  <span class="inline-flex items-center text-sm font-medium text-primary-600 group-hover:text-primary-700">
    {t('product.learnMore')}
    <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </span>
</a>
