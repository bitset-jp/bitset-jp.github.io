---
interface Props {
  date: string;
  title: string;
  description?: string;
}

const { date, title, description } = Astro.props;
---

<div class="relative pl-8 pb-8 border-l-2 border-primary-200 last:border-l-0 last:pb-0">
  <div class="absolute -left-2 top-0 w-4 h-4 bg-primary-600 rounded-full border-2 border-white"></div>
  <time class="text-xs font-medium text-primary-600 uppercase tracking-wider">{date}</time>
  <h4 class="text-base font-semibold text-gray-900 mt-1">{title}</h4>
  {description && <p class="text-sm text-gray-600 mt-1">{description}</p>}
</div>
