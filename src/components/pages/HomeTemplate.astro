---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import SectionHeading from '../SectionHeading.astro';
import ServiceCard from '../ServiceCard.astro';
import ProductCard from '../ProductCard.astro';
import PhilosophyCard from '../PhilosophyCard.astro';
import TechBadge from '../TechBadge.astro';
import TimelineItem from '../TimelineItem.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/translations';

const lang = (Astro.currentLocale ?? 'ja') as Lang;
const t = useTranslations(lang);

const HOME_NEWS_LIMIT = 5;

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => {
    const t1 = a.data.pubDate.getTime();
    const t2 = b.data.pubDate.getTime();
    if (t2 !== t1) return t2 - t1;
    return b.id.localeCompare(a.id);
  })
  .slice(0, HOME_NEWS_LIMIT);

const allProducts = await getCollection('products');
const featuredProducts = allProducts.sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const serviceIcons = [
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
  '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>',
];

const serviceKeys = ['embedded', 'iot', 'software', 'network', 'av', 'hardware'] as const;

const services = serviceKeys.map((key, i) => ({
  icon: serviceIcons[i],
  title: t(`home.services.${key}.title` as any),
  description: t(`home.services.${key}.desc` as any),
}));

const techStack = [
  'Raspberry Pi', 'ARM', 'Linux', 'ECHONET Lite', 'Python', 'C/C++',
  'Rust', 'Node.js', 'React', 'TypeScript', 'HDMI', 'USB',
  'Wi-Fi', 'LAN', 'PCAP', 'Wireshark', '3D Printing', 'Docker',
];

const timelineKeys = ['1', '2', '3', '4', '5', '6'] as const;
const timelineDates = ['2017', '2017', '2018', '2019', '2020', '2024'];
const timeline = timelineKeys.map((k, i) => ({
  date: timelineDates[i],
  title: t(`home.timeline.${k}.title` as any),
  description: t(`home.timeline.${k}.desc` as any),
}));

const philosophyKeys = ['1', '2', '3', '4'] as const;

function formatNewsDate(d: Date): string {
  return d.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title={t('home.title')}>
  <Hero
    title={t('home.hero.title')}
    subtitle={t('home.hero.subtitle')}
    showCta={true}
  />

  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('home.news.title')} subtitle={t('home.news.subtitle')} />
      <ul class="mt-8 divide-y divide-gray-100 max-w-3xl">
        {recentNews.map((item) => {
          const title = lang === 'ja' ? item.data.titleJa : item.data.title;
          const desc =
            lang === 'ja'
              ? (item.data.descriptionJa ?? item.data.description)
              : (item.data.description ?? item.data.descriptionJa);
          return (
            <li class="py-4 first:pt-0">
              <time class="text-sm text-primary-600 font-medium" datetime={item.data.pubDate.toISOString()}>
                {formatNewsDate(item.data.pubDate)}
              </time>
              <p class="mt-1 font-semibold text-gray-900">{title}</p>
              {desc && <p class="mt-1 text-sm text-gray-600 line-clamp-2">{desc}</p>}
            </li>
          );
        })}
      </ul>
      <div class="mt-8">
        <a
          href={getLocalizedPath('/news', lang)}
          class="inline-flex items-center text-primary-600 font-medium hover:text-primary-800"
        >
          {t('home.news.viewAll')}
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title={t('home.services.title')}
        subtitle={t('home.services.subtitle')}
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <ServiceCard icon={s.icon} title={s.title} description={s.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title={t('home.products.title')}
        subtitle={t('home.products.subtitle')}
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard
            slug={product.id}
            title={lang === 'ja' ? product.data.titleJa : product.data.title}
            description={lang === 'ja' ? product.data.descriptionJa : product.data.description}
            category={product.data.category}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={getLocalizedPath('/products', lang)} class="inline-flex items-center px-6 py-3 border border-primary-600 text-primary-600 hover:bg-primary-50 font-medium rounded-lg transition-colors">
          {t('home.products.viewAll')}
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title={t('home.philosophy.title')}
        subtitle={t('home.philosophy.subtitle')}
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {philosophyKeys.map((k) => (
          <PhilosophyCard
            number={Number(k)}
            title={t(`home.philosophy.${k}.title` as any)}
            titleJa={t(`home.philosophy.${k}.titleJa` as any)}
            description={t(`home.philosophy.${k}.desc` as any)}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <SectionHeading title={t('home.journey.title')} centered={false} />
          <div class="mt-8">
            {timeline.map((item) => (
              <TimelineItem date={item.date} title={item.title} description={item.description} />
            ))}
          </div>
        </div>
        <div>
          <SectionHeading title={t('home.techStack.title')} centered={false} />
          <p class="text-gray-600 mb-6">{t('home.techStack.subtitle')}</p>
          <div class="flex flex-wrap gap-2">
            {techStack.map((tech) => (
              <TechBadge label={tech} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-br from-primary-900 to-primary-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white">{t('home.cta.title')}</h2>
      <p class="mt-4 text-lg text-primary-200">{t('home.cta.subtitle')}</p>
      <div class="mt-8">
        <a href={getLocalizedPath('/contact', lang)} class="inline-flex items-center px-8 py-4 bg-accent-500 hover:bg-accent-600 text-white font-semibold rounded-lg transition-colors text-lg">
          {t('home.cta.button')}
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
