---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import SectionHeading from '../SectionHeading.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/translations';

const lang = (Astro.currentLocale ?? 'ja') as Lang;
const t = useTranslations(lang);

const jobDescKeys = ['1', '2'] as const;
const candidateKeys = ['1', '2', '3', '4', '5'] as const;
const juniorKeys = ['1', '2'] as const;
const seniorKeys = ['1', '2', '3'] as const;
const commonKeys = ['1', '2', '3'] as const;

const benefitKeys = ['workHours', 'holidays', 'commute', 'location', 'salary', 'contract'] as const;
const benefits = benefitKeys.map((k) => ({
  label: t(`recruit.benefits.${k}.label` as any),
  value: t(`recruit.benefits.${k}.value` as any),
}));

const promiseKeys = ['1', '2'] as const;

const benefitIcons = [
  '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>',
  '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>',
  '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
  '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
];
---

<BaseLayout title={t('recruit.title')}>
  <Hero
    title={t('recruit.hero.title')}
    subtitle={t('recruit.hero.subtitle')}
  />

  <!-- Job Description -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('recruit.jobDescription.title')} />
      <ul class="mt-8 space-y-4">
        {jobDescKeys.map((k) => (
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="text-gray-700 text-lg">{t(`recruit.jobDescription.${k}` as any)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ideal Candidate -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('recruit.idealCandidate.title')} />
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        {candidateKeys.map((k) => (
          <div class="flex items-start gap-3 bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <span class="flex-shrink-0 w-8 h-8 bg-accent-100 text-accent-600 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </span>
            <span class="text-gray-700">{t(`recruit.idealCandidate.${k}` as any)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Required Skills -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('recruit.skills.title')} />
      <div class="mt-8 space-y-8">
        <!-- Junior -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold text-primary-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary-500 rounded-full"></span>
            {t('recruit.skills.junior.title')}
          </h3>
          <ul class="space-y-2">
            {juniorKeys.map((k) => (
              <li class="flex items-start gap-2 text-gray-700">
                <span class="text-primary-400 mt-1.5">&#8226;</span>
                {t(`recruit.skills.junior.${k}` as any)}
              </li>
            ))}
          </ul>
        </div>

        <!-- Senior -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold text-primary-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary-500 rounded-full"></span>
            {t('recruit.skills.senior.title')}
          </h3>
          <ul class="space-y-2">
            {seniorKeys.map((k) => (
              <li class="flex items-start gap-2 text-gray-700">
                <span class="text-primary-400 mt-1.5">&#8226;</span>
                {t(`recruit.skills.senior.${k}` as any)}
              </li>
            ))}
          </ul>
        </div>

        <!-- Common -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold text-primary-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary-500 rounded-full"></span>
            {t('recruit.skills.common.title')}
          </h3>
          <ul class="space-y-2">
            {commonKeys.map((k) => (
              <li class="flex items-start gap-2 text-gray-700">
                <span class="text-primary-400 mt-1.5">&#8226;</span>
                {t(`recruit.skills.common.${k}` as any)}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('recruit.benefits.title')} />
      <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden divide-y divide-gray-100">
        {benefits.map((b, i) => (
          <div class="flex items-center gap-4 px-6 py-4">
            <span class="flex-shrink-0 w-10 h-10 bg-primary-50 text-primary-600 rounded-lg flex items-center justify-center" set:html={benefitIcons[i]} />
            <span class="w-32 flex-shrink-0 text-sm font-semibold text-gray-900">{b.label}</span>
            <span class="text-gray-700">{b.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Promises -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('recruit.promises.title')} />
      <div class="mt-8 space-y-4">
        {promiseKeys.map((k) => (
          <div class="flex items-start gap-4 bg-primary-50 rounded-xl p-6 border border-primary-100">
            <span class="flex-shrink-0 w-8 h-8 bg-primary-600 text-white rounded-full flex items-center justify-center text-sm font-bold">
              {k}
            </span>
            <p class="text-gray-800 leading-relaxed">{t(`recruit.promises.${k}` as any)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Apply CTA -->
  <section class="py-20 bg-gradient-to-br from-primary-900 to-primary-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white">{t('recruit.apply.title')}</h2>
      <p class="mt-4 text-lg text-primary-200">{t('recruit.apply.desc')}</p>
      <div class="mt-8">
        <a href={getLocalizedPath('/contact', lang)} class="inline-flex items-center px-8 py-4 bg-accent-500 hover:bg-accent-600 text-white font-semibold rounded-lg transition-colors text-lg">
          {t('recruit.apply.button')}
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
